  ./selfcmd deepseek-scale-probe
  ./selfcmd deepseek-budget-probe
  ./selfcmd deepseek-256-probe
  ./selfcmd deepseek-auto-probe
  ./selfcmd deepseek-stability-run [steps]
  ./selfcmd deepseek-realdata-probe
