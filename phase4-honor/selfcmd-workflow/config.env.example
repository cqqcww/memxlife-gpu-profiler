# Copy this file to config.env and adjust only if the course service changes.

COURSE_SERVER=10.176.37.31
COURSE_USER_ID=23302010089
COURSE_GPU=1

# Phase 4 code should land directly under /workspace so report4.md is
# visible as /workspace/report4.md during final submission.
REMOTE_DIR=/workspace

COURSE_SSH_KEY=/Users/amanda/.ssh/mlsys_course_ed25519
COURSE_SSH_PASSWORD=mlsys

# The guide currently says the final submission is a report. If the course
# service exposes a Phase 4 endpoint, keep it configurable here.
COURSE_SUBMIT_PATH=/submit4

COURSE_START_TIMEOUT_SECONDS=1800
COURSE_START_POLL_SECONDS=10
COURSE_CURL_CONNECT_TIMEOUT=8
COURSE_CURL_MAX_TIME=30

# Keep local fetches lightweight. Full checkpoints and token caches stay remote.
PHASE4_FETCH_MAX_BYTES=25000000
REMOTE_TAIL_LINES=120
